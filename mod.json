{
	"geode": "5.9.0",
	"gd": {
		"win": "2.2081",
		"android": "2.2081",
		"mac": "2.2081",
		"ios": "2.2081"
	},
	"id": "cosmella.endscreen-rewards",
	"name": "Endscreen rewards",
	"version": "v1.0.3",
	"developer": "Cosmella",
	"links": {"source": "https://github.com/Cosmella-v/endscreen-rewards-api"},
	"api": {"include": [
		"include/*.hpp"
	]},
	"tags": ["api"],
	"incompatibilities" : {
		"zilko.jam": {
			"breaking": true,
			"version": "<=v1.0.7"
		}
	},
	"description": "rewards on the endscreen api",
	"dependencies": {
		"geode.node-ids": ">=v1.23.3"
	},
	"settings": {
		"shaderless" : {
			"name": "Disable Shaders",
			"type": "bool",
			"default" : false,
			"description": "Disables the use of shaders within the mod. <cr>Only use if your device cannot handle the opacity shader</c>"
		}
	},
	"resources": {
		"files": [
			"shaders/*.glsl"
		]
	}
}
